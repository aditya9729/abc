flowchart LR
  subgraph P[Planner: canonical coordinator and publication]
    pins[Checkpoint and metadata pins\nComplete recipe and split seeds]
    lease[Exclusive GPU0 lease\nFinite watchdog]
    cohort[demo_cohort publisher\nAuthenticate parent, worker and episodes]
  end
  subgraph C[Collector agent: implemented and native collection verified]
    gate[Config, artifact and lease admission]
    scope[Scoped public constructor proxies\nRestored in finally]
    capture[Observe original public calls\nNo added step, render or judge]
    trace[Raw RGB streams and bounded numeric traces\nExact RTC requests and issued-row linkage]
    manifest[Episode manifest then worker receipt\nNoncircular SHA256 lineage\nApproval fields false]
  end
  subgraph A[Original ABC: three TRAIN and three validation successes]
    rollout[Unchanged run_eval and rollout_worlds]
    sampler[ABC-VLA flow10\nH30, execute15, RTC prefix4/lead4]
    sim[CPU MuJoCo physics\nMJWarp cameras168x224]
  end
  subgraph E[EXPO agent and data owners]
    reader[Installed task dataset reader\n3493 TRAIN and3324 validation H16 windows]
    stats[Original OpenPI RunningStats\nTRAIN only, actual cohort verified]
    qc[Atlas and Engram QC\nPending separate review]
    train[Task SFT adapter installed and CPU tested\nNative capacity and training pending]
    eval[Captured validation reset adapter\nPending before matched policy rollouts]
  end
  reviewer[Independent reviewer\nCode and evidence checks]
  pins --> gate
  lease -. control admission .-> gate
  gate --> scope
  scope -. calls unchanged .-> rollout
  rollout --> sampler
  sampler -->|Actual float32 physical14 commands| sim
  sim -->|Original observations and task evaluations| rollout
  rollout -->|Intercept only existing public calls| capture
  capture --> trace
  trace --> manifest
  manifest --> cohort
  cohort --> reader
  reader --> stats
  reader -. task quality and approval .-> qc
  reader -. separate training admission .-> train
  stats -. pinned input .-> train
  train -. selected actual policy .-> eval
  reviewer -. review .-> scope
  reviewer -. verify lineage .-> cohort
