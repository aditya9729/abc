+def resolve_task_callback(path: str):
+    """Resolve an explicitly named installed public task callback."""
+    if not isinstance(path, str) or path.count(":") != 1:
+        raise ValueError("Task callback must be module:callable")
+    module_name, name = path.split(":")
+    if not module_name or not name.isidentifier() or name.startswith("_"):
+        raise ValueError("Task callback must name a public callable")
+    callback = getattr(importlib.import_module(module_name), name)
+    if not callable(callback):
+        raise TypeError("Task callback is not callable")
+    return callback
+
+
+def load_task_dataset(dataset_path, task_config, num_data=None):
+    """Task-specific data dispatch; the original DROID loader is unchanged."""
+    path = getattr(task_config, "dataset_loader", None)
+    if path is not None:
+        return resolve_task_callback(path)(dataset_path, task_config, num_data=num_data)
+    if task_config.env_type != "droid":
+        raise ValueError(f"Unsupported dataset type: {task_config.env_type}")
+    from expo_ft.env.droid_utils import process_droid_dataset
+    return process_droid_dataset(dataset_path, task_config, num_data=num_data)
